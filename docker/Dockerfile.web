# docker/Dockerfile.web
FROM node:20.19.0-alpine AS builder

WORKDIR /app

# 1. 复制 root 和 workspace 的 package.json，让 npm 感知完整的多包结构
COPY package*.json ./
COPY electron/package*.json ./electron/

# 2. 统一安装所有依赖（包含 workspaces 的依赖），依靠上一步的配置，这里会成功解析
RUN npm install --ignore-scripts

# 3. 复制全部源码（包括 scripts 目录）
COPY . .

# 4. 手动执行后置脚本，此时 monaco-editor 等资源已经在 node_modules 中就绪了
RUN npm run postinstall --if-present

# 5. 注入环境变量并构建生产代码
ENV VITE_API_BASE_URL=""
RUN npm run dashboard:build

# ================= 运行阶段 =================
FROM node:20.19.0-alpine
WORKDIR /app

RUN npm install -g pm2

# 从构建阶段拷贝编译产物
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/electron/dist-react ./electron/dist-react
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["pm2-runtime", "start", "npm", "--name", "quantmind-web", "--", "run", "dashboard:preview"]
