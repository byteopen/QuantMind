# ================= 1. 构建阶段 =================
FROM node:20.19.0-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY electron/package*.json ./electron/
RUN npm install --ignore-scripts
COPY . .
RUN npm run postinstall --if-present
ENV VITE_API_BASE_URL=""

# 【修改这里】：跳过默认的 dashboard:build (它会同时构建 web 和 桌面端)
# 改为仅触发 React 网页端的构建
RUN npm run build:react -w QuantMind

# ================= 2. 运行阶段 =================
FROM nginx:alpine

# 清空默认的静态文件
RUN rm -rf /usr/share/nginx/html/*

# 拷贝静态资源 (这里依然是从 dist-react 目录拷贝)
COPY --from=builder /app/electron/dist-react /usr/share/nginx/html

# 写入针对 SPA 应用的 Nginx 配置文件
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html index.htm; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ { \
        expires 30d; \
        add_header Cache-Control "public, no-transform"; \
    } \
}' > /etc/nginx/conf.d/default.conf

# 创建启动脚本：动态注入环境变量
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'echo "window.SERVER_API_URL = \"${SERVER_API_URL}\";" > /usr/share/nginx/html/config.js' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 80

CMD ["/docker-entrypoint.sh"]
