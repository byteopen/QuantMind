# ================= 1. 构建阶段 (保持不变) =================
FROM node:20.19.0-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY electron/package*.json ./electron/
RUN npm install --ignore-scripts
COPY . .
RUN npm run postinstall --if-present
ENV VITE_API_BASE_URL=""
RUN npm run dashboard:build

# ================= 2. 运行阶段 (切换为 Nginx) =================
FROM nginx:alpine

# 清空默认的静态文件
RUN rm -rf /usr/share/nginx/html/*

# 从 builder 阶段仅复制编译好的静态产物 (不需要 node_modules)
COPY --from=builder /app/electron/dist-react /usr/share/nginx/html

# 写入针对 SPA 应用的 Nginx 配置文件 (解决前端路由刷新 404 问题)
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html index.htm; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    # 静态资源缓存策略 \
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ { \
        expires 30d; \
        add_header Cache-Control "public, no-transform"; \
    } \
}' > /etc/nginx/conf.d/default.conf

# 暴露 80 端口
EXPOSE 80

# 启动 Nginx (默认 entrypoint 会接管)
CMD ["nginx", "-g", "daemon off;"]
